<?xml version="1.0" encoding="utf-8"?>
<!--
    A still of the cycle ring for the widget picker.

    The live widget draws this on a Canvas because Glance has no arc primitive (see
    CycleRingRenderer); a preview cannot run that code, so the arcs are traced here instead. Angles
    are measured from the top, clockwise, on a 29-day cycle: period days 1-5, fertile window 12-17,
    today on day 8. Colours are the light `*Accent` values from WidgetTheme, which are the ones
    legible directly on the surface.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Track -->
    <path
        android:pathData="M24,6 A18,18 0 1,1 24,42 A18,18 0 1,1 24,6"
        android:strokeColor="#FFF7E3EA"
        android:strokeWidth="5.5" />

    <!-- Period, days 1-5 -->
    <path
        android:pathData="M24,6 A18,18 0 0,1 39.89,15.55"
        android:strokeColor="#FFD93672"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />

    <!-- Fertile window, days 12-17 -->
    <path
        android:pathData="M33.27,39.43 A18,18 0 0,1 14.73,39.43"
        android:strokeColor="#FF43A047"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />

    <!-- Today marker, day 8: a dot of the ring's own thickness, centred on the track at 99.3deg -->
    <path
        android:pathData="M44.66,26.91 A2.9,2.9 0 1,1 38.86,26.91 A2.9,2.9 0 1,1 44.66,26.91"
        android:fillColor="#FFC77800" />
</vector>
