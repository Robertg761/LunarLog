<?xml version="1.0" encoding="utf-8"?>
<!--
    Quick log. A 4x1 strip by default — the shape that fits under an existing row of icons, which is
    where a one-tap logger is actually useful.

    Matches QuickLogWidget's buckets: COMPACT 250x40dp (4x1) and TALL 250x110 (4x2), the taller one
    adding the water row. See widget_info.xml for the cell-dp formula and why there is no
    updatePeriodMillis.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_quick_log_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="320dp"
    android:maxResizeHeight="180dp"
    android:previewImage="@drawable/widget_preview_image_quick_log"
    android:previewLayout="@layout/widget_preview_quick_log"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:widgetCategory="home_screen"
    tools:targetApi="s">
</appwidget-provider>
